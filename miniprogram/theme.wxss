page { --green:#087a51; --mint:#d7f3e7; --line:#62a98b; --text:#252525; --muted:#8b8f8d; --bg:#e6f8ee; background:linear-gradient(145deg,#a8dfc0 0%,#dff6e7 48%,#fbfbe8 100%); color:var(--text); font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif; }
.page { min-height:100vh; background:linear-gradient(180deg,rgba(232,250,239,.78),rgba(255,255,255,.9)); }
.header { padding:44rpx 44rpx 22rpx; display:flex; align-items:center; justify-content:space-between; }
.brand { font-size:48rpx; font-weight:700; letter-spacing:2rpx; color:var(--green); }
.badge { width:62rpx; height:62rpx; border:4rpx solid #c5a65d; border-radius:50%; color:#c5a65d; display:flex; align-items:center; justify-content:center; font-size:24rpx; }
.search { margin:0 44rpx 26rpx; height:86rpx; border:3rpx solid var(--line); border-radius:46rpx; display:flex; align-items:center; padding:0 28rpx; color:var(--muted); font-size:30rpx; background:#fff; }
.search-icon { font-size:44rpx; margin-right:18rpx; color:var(--green); }
.categories { display:flex; padding:8rpx 34rpx 20rpx; gap:22rpx; white-space:nowrap; overflow-x:auto; }
.category { width:112rpx; flex:none; text-align:center; font-size:25rpx; }
.category::before { display:none !important; content:none !important; }
.category:nth-child(1)::before{content:'';background:#fff}.category:nth-child(2)::before{content:'';background:#fff}.category:nth-child(3)::before{content:'';background:#fff}.category:nth-child(4)::before{content:'';background:#fff}
.category-icon { width:78rpx; height:78rpx; margin:0 auto 10rpx; border-radius:50%; background:var(--mint); color:var(--green); display:flex; align-items:center; justify-content:center; font-size:36rpx; }
.areas { display:flex; gap:18rpx; padding:8rpx 44rpx 28rpx; white-space:nowrap; overflow-x:auto; }
.area { padding:14rpx 30rpx; border:2rpx solid #c9ccca; border-radius:34rpx; font-size:27rpx; color:#555; background:white; }
.area.active { color:var(--green); border-color:var(--line); background:#f0fff8; }
.sortbar { display:flex; justify-content:space-around; padding:4rpx 80rpx 22rpx; color:#666; font-size:27rpx; }
.sortbar .active { color:var(--green); font-weight:600; border-bottom:5rpx solid #55a67f; padding-bottom:10rpx; }
.post-card { margin:0 38rpx 22rpx; padding:28rpx 30rpx 24rpx; background:#fff; border:2rpx solid #b9dcca; border-radius:28rpx; box-shadow:0 5rpx 18rpx rgba(24,100,65,.04); }
.post-head { display:flex; align-items:center; }
.avatar { width:66rpx; height:66rpx; border-radius:50%; background:#d9eee4; margin-right:18rpx; }
.nickname { font-size:31rpx; font-weight:600; flex:1; }.time { color:#aaa; font-size:24rpx; }
.board { color:#82a08f; font-size:23rpx; margin:12rpx 0 18rpx 84rpx; }
.title { font-size:34rpx; font-weight:600; margin-bottom:12rpx; }.content { font-size:29rpx; line-height:1.6; color:#303030; display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden; }
.stats { display:flex; gap:28rpx; color:#9a9e9c; font-size:24rpx; margin-top:22rpx; }
.fab { position:fixed; right:38rpx; bottom:148rpx; width:102rpx; height:102rpx; border-radius:50%; background:#55c6a0; color:white; font-size:62rpx; line-height:96rpx; text-align:center; box-shadow:0 8rpx 20rpx #9bcfbd; }
.tabbar { position:fixed; bottom:0; left:0; right:0; height:122rpx; background:#fff; border-top:1rpx solid #eee; display:flex; justify-content:space-around; padding-bottom:env(safe-area-inset-bottom); }
.tab { text-align:center; padding-top:15rpx; color:#999; font-size:24rpx; }.tab.active { color:#0aa05d; }.tab-icon { display:block; font-size:43rpx; height:54rpx; }
.empty { text-align:center; color:#aaa; padding:100rpx 0; }
.page-bg{position:fixed;inset:0;width:100%;height:100%;z-index:-1;opacity:.38}
