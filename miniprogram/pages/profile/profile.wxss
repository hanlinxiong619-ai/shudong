@import "../../theme.wxss";.profile{padding:30rpx 38rpx}.profile-head{display:flex;align-items:center;gap:24rpx;padding:28rpx 0 45rpx}.big{width:120rpx;height:120rpx}.profile-head button{font-size:24rpx;color:#fff;background:#0aa05d;border-radius:30rpx;padding:0 25rpx}.section-title{font-size:34rpx;font-weight:600;margin:28rpx 0 20rpx}.menu{background:#fff;border-radius:18rpx;border:1rpx solid #e3eee9}.menu-item{display:flex;justify-content:space-between;padding:30rpx 24rpx;border-bottom:1rpx solid #edf3f0;color:#234c3d;font-size:28rpx}.menu-item:last-child{border-bottom:0}.menu-item text:last-child{color:#91a69d;font-size:24rpx}

.profile{position:relative;z-index:1}.profile-head button{position:relative;z-index:5;pointer-events:auto}.menu-item{position:relative;z-index:5;pointer-events:auto}


.logout-btn{margin-top:14rpx;background:#fff;color:#087a51;border:1rpx solid #b9dcca;font-size:24rpx}

.profile-card{margin:20rpx 0 24rpx;padding:30rpx;background:linear-gradient(135deg,#58cbb0,#28ae88);border-radius:24rpx;display:flex;align-items:center}.profile-card .big{width:128rpx;height:128rpx;border-radius:50%;margin-right:24rpx;background:#d7f3e7}.identity{display:flex;flex-direction:column}.identity .nickname{color:#fff;font-size:36rpx;font-weight:700}.identity button{margin-top:18rpx;margin-left:0;background:#fff;color:#087a51;border-radius:36rpx;font-size:25rpx;padding:0 28rpx}.menu-item{display:flex;justify-content:space-between;align-items:center}
.profile-card{display:block!important;padding:28rpx!important;background:linear-gradient(135deg,#54cbb6,#2db69a)!important;border-radius:16rpx!important}.profile-main{display:flex;align-items:center;min-height:112rpx}.profile-main .big{width:104rpx!important;height:104rpx!important;margin-right:22rpx!important;border:4rpx solid rgba(255,255,255,.85)}.identity{flex:1}.profile-note{display:block;margin-top:7rpx;color:rgba(255,255,255,.82);font-size:22rpx}.logged-out{justify-content:center;text-align:center}.login-btn{width:180rpx!important;margin:14rpx auto 0!important}.profile-actions{display:grid;grid-template-columns:repeat(3,1fr);margin-top:24rpx;padding-top:20rpx;border-top:1rpx solid rgba(255,255,255,.25)}.profile-action{min-width:0;text-align:center;color:#fff;font-size:21rpx;border-right:1rpx solid rgba(255,255,255,.2)}.profile-action:last-child{border-right:0}.action-value{display:block;margin-bottom:7rpx;font-size:29rpx;font-weight:700}.menu{background:#fff;border-radius:16rpx;overflow:hidden}.menu-item{min-height:88rpx;padding:0 26rpx;border-bottom:1rpx solid #edf2ef}
