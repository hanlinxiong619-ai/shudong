@import "../../theme.wxss";.detail{padding:20rpx 0}.full{-webkit-line-clamp:unset}.actions{display:flex;gap:20rpx;margin-top:30rpx}.actions button{font-size:26rpx;background:#f0fff8;color:#087a51}.comment-title{font-size:32rpx;font-weight:600;padding:20rpx 44rpx}.comment{margin:0 44rpx;padding:20rpx 0;border-bottom:1rpx solid #eee;display:flex;gap:20rpx}.comment .nickname{color:#087a51}

.comment{display:block!important;word-break:break-word;white-space:normal}.comment-head{display:flex;align-items:center;margin-bottom:12rpx}.comment-avatar{width:52rpx;height:52rpx;border-radius:50%;margin-right:14rpx}.comment-body{display:block;line-height:1.7;white-space:pre-wrap;word-break:break-word}

.comment-actions{display:flex;gap:30rpx;margin-top:10rpx;color:#087a51;font-size:23rpx}
.post-images{display:grid;grid-template-columns:repeat(3,1fr);gap:10rpx;margin-top:20rpx}.post-images image{width:100%;height:190rpx;border-radius:10rpx}.contact-box{display:flex;flex-direction:column;gap:8rpx;margin-top:20rpx;padding:20rpx;background:#eefaf4;border-radius:12rpx}.contact-label{font-size:23rpx;color:#087a51}.price{margin-top:16rpx;color:#d67a27;font-weight:600}
.post-images{display:block!important;width:100%;white-space:nowrap;overflow:hidden}.post-images image{display:inline-block!important;width:250rpx!important;height:210rpx!important;margin-right:10rpx;vertical-align:top}.contact-box{flex-direction:row!important;align-items:center;justify-content:space-between}.contact-box>view{display:flex;flex-direction:column;gap:8rpx}.contact-box button{margin:0;padding:0 24rpx;height:58rpx;line-height:58rpx;background:#087a51;color:#fff;font-size:24rpx;border-radius:30rpx}
.contact-box{display:flex!important;justify-content:flex-end!important}.contact-box button{margin:0;padding:0 26rpx;height:58rpx;line-height:58rpx;background:#087a51;color:#fff;border-radius:30rpx;font-size:24rpx}.contact-box button::after{border:0}
.detail{height:100vh;overflow:hidden}.detail-scroll{height:calc(100vh - 126rpx)}.post-like-row{display:flex;justify-content:flex-end;margin-top:24rpx}.post-like-row button{margin:0;background:#eefaf4;color:#087a51}.copy-contact{width:auto;display:block;margin:20rpx 0 0 auto;padding:0 28rpx;height:62rpx;line-height:62rpx;border-radius:32rpx;background:#087a51;color:#fff;font-size:24rpx}.copy-contact::after{border:0}.child-comment{margin-left:92rpx!important;padding-left:0!important;border-left:0!important;max-width:calc(100% - 136rpx)}.reply-prefix{color:#087a51;font-weight:600}.comment-actions{justify-content:flex-start;gap:30rpx}.comment-like{margin-left:auto}.comment-composer{position:fixed;left:0;right:0;bottom:0;z-index:30;padding:12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));background:#fff;border-top:1rpx solid #dceae3}.composer-row{display:flex;align-items:center;gap:12rpx}.composer-row input{flex:1;min-width:0;height:72rpx;padding:0 22rpx;background:#f2f7f4;border-radius:36rpx}.composer-row button{width:120rpx;height:72rpx;line-height:72rpx;margin:0;padding:0;background:#20a878;color:#fff;border-radius:36rpx;font-size:25rpx}.reply-target{display:flex;justify-content:space-between;gap:20rpx;margin-bottom:8rpx;color:#58736a;font-size:22rpx}.reply-target text:first-child{white-space:normal;overflow-wrap:anywhere;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}.comment,.comment-body{box-sizing:border-box;min-width:0;max-width:100%;overflow-wrap:anywhere;word-break:break-word;white-space:pre-wrap}.bottom-space{height:40rpx}
