<view class="page"><view class="header"><text class="brand">树洞热榜</text><text class="sub">最受关注的10条帖子</text></view><view class="post-card" wx:for="{{posts}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="rank">{{index+1}}</view><view class="board">{{item.boardName}}</view><view wx:if="{{item.title}}" class="title">{{item.title}}</view><view class="content">{{item.content}}</view><view class="stats">◷ {{item.viewCount||0}}　♡ {{item.likeCount||0}}　□ {{item.commentCount||0}}</view></view><view wx:if="{{!posts.length}}" class="empty">暂时还没有热榜帖子</view></view>
