<view class="page publish"><view class="header"><text class="brand">发布帖子</text></view><picker range="{{boards}}" range-key="name" bindchange="pick"><view class="picker">选择板块：{{boardName}}</view></picker><picker range="{{['花都','海珠']}}" bindchange="pickCampus"><view class="picker">校区：{{campus}}</view></picker><picker range="{{collegeOptions}}" bindchange="pickCollege"><view class="picker">学院：{{college||'全部学院'}}</view></picker><input class="field" placeholder="标题（可选）" bindinput="inputTitle"/><textarea class="editor" placeholder="写下你想分享的内容..." maxlength="10000" bindinput="inputContent"></textarea><input wx:if="{{group==='MARKET'}}" class="field" placeholder="联系方式（选填）" bindinput="inputContact"/><input wx:if="{{group==='MARKET'}}" class="field" type="digit" placeholder="预估价格（选填）" bindinput="inputPrice"/><view wx:if="{{group==='MARKET'}}" class="image-picker" bindtap="chooseImages">＋ 添加物品图片</view><view class="image-list"><image wx:for="{{images}}" wx:key="*this" src="{{item}}" mode="aspectFill"/></view><button class="submit" bindtap="submit">发布</button></view>
