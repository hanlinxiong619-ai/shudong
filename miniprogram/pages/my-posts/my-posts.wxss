.page{min-height:100vh;padding:30rpx;background:linear-gradient(145deg,#a8dfc0,#dff6e7,#fbfbe8);box-sizing:border-box}.title{font-size:40rpx;font-weight:700;color:#087a51;margin-bottom:24rpx}.post-card{background:#fff;border-radius:18rpx;padding:24rpx;margin-bottom:18rpx}.content{color:#415c52;line-height:1.6}.stats{margin-top:14rpx;color:#8c9d96;font-size:22rpx}.empty{text-align:center;color:#899;padding:100rpx 0}.post-row{display:flex;align-items:center;justify-content:space-between}.board{color:#087a51;font-size:23rpx}.delete-btn{margin:0;padding:0 20rpx;height:54rpx;line-height:54rpx;background:#fff;color:#d9534f;font-size:23rpx;border:1rpx solid #f1c5c3}.delete-btn::after{border:0}.post-title{margin-top:12rpx;font-size:30rpx;font-weight:600}.thumb{width:180rpx;height:150rpx;margin-top:14rpx;border-radius:10rpx}
.post-time{margin-left:14rpx;color:#99a69f;font-size:21rpx}
