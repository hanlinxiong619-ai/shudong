<view class="page"><view class="title">{{replies?"我的回复":"我的评论"}}</view><view wx:if="{{loading}}" class="empty">正在加载…</view><view wx:if="{{!loading&&!items.length}}" class="empty">暂无记录</view><view wx:for="{{items}}" wx:key="id" class="post-card" data-post-id="{{item.postId}}" bindtap="openPost"><view class="content">{{item.content}}</view><view class="stats">{{item.createdAt}}</view></view></view>