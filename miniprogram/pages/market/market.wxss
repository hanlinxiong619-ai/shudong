/* 页面整体：设置页面背景、内边距和基础字体 */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx;
  background: #f6faf8;
  color: #29483d;
}

/* 页面标题：显示集市名称和副标题 */
.header {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-bottom: 28rpx;
}

/* 页面主标题：显示“集市” */
.brand {
  font-size: 46rpx;
  font-weight: 700;
  color: #087a51;
}

/* 页面副标题：显示校园生活信息 */
.subtitle {
  font-size: 25rpx;
  color: #7a968b;
}

/* 分类区域：支持横向滚动显示多个分类 */
.filters {
  width: 100%;
  white-space: nowrap;
  margin: 0 -30rpx 24rpx;
  padding: 8rpx 30rpx 18rpx;
  box-sizing: border-box;
}

/* 分类项目：控制每个分类的大小、间距和文字排列 */
.filter {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  width: 147rpx;
  height: 176rpx;
  padding: 8rpx 10rpx 12rpx;
  margin-right: 14rpx;
  box-sizing: border-box;
  background: transparent;
  border: 0;
  color: #416e5d;
  font-size: 25rpx;
  vertical-align: top;
  white-space: normal;
}

/* 分类图标：设置图标大小、背景、圆角和阴影 */
.filter-icon {
  display: block;
  width: 86rpx;
  height: 86rpx;
  margin-bottom: 8rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(38, 107, 75, 0.12);
}

/* 全部内容图标：用文字符号代替图片图标 */
.all-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #087a51;
  font-size: 42rpx;
  line-height: 86rpx;
}

/* 分类名称：控制分类文字的宽度、对齐方式和大小 */
.filter > text {
  display: block;
  width: 100%;
  text-align: center;
  color: inherit;
  font-size: 25rpx;
  line-height: 1.4;
  white-space: nowrap;
}

/* 当前选中的分类：改变文字颜色和字体粗细 */
.filter.active {
  color: #087a51;
  font-weight: 600;
}

/* 当前选中的图标：改变图标背景颜色 */
.filter.active .filter-icon {
  background: #d7f3e7;
}

/* 空数据区域：没有帖子时显示提示文字 */
.empty {
  padding: 90rpx 30rpx;
  text-align: center;
  color: #8ca39a;
  font-size: 27rpx;
}

/* 帖子卡片：设置每一条帖子的白色卡片样式 */
.post-card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(38, 107, 75, 0.08);
}

/* 帖子顶部信息：排列头像、昵称和发布时间 */
.post-head {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

/* 用户头像：设置匿名用户头像占位区域 */
.avatar {
  width: 62rpx;
  height: 62rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #d7f3e7;
}

/* 用户昵称：显示匿名用户名称 */
.nickname {
  font-size: 27rpx;
  font-weight: 600;
  color: #355b4d;
}

/* 发布时间：显示帖子创建时间 */
.time {
  margin-left: auto;
  font-size: 22rpx;
  color: #9bad a5;
}

/* 帖子分类：显示当前帖子的分类名称 */
.board {
  display: inline-block;
  margin-bottom: 14rpx;
  padding: 7rpx 14rpx;
  border-radius: 20rpx;
  background: #e4f6ed;
  color: #087a51;
  font-size: 22rpx;
}

/* 帖子标题：显示帖子标题 */
.title {
  margin-bottom: 12rpx;
  font-size: 31rpx;
  line-height: 1.5;
  font-weight: 650;
  color: #274a3d;
}

/* 帖子正文：显示帖子详细内容 */
.content {
  font-size: 27rpx;
  line-height: 1.7;
  color: #557066;
  word-break: break-all;
}

/* 价格信息：显示帖子中的预估价格 */
.price {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #d67a27;
}

/* 帖子统计：显示浏览量、点赞数和评论数 */
.stats {
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf3ef;
  color: #91a59c;
  font-size: 22rpx;
}

/* 发布按钮：固定在页面右下角用于发布新帖子 */
.fab {
  position: fixed;
  right: 34rpx;
  bottom: 42rpx;
  width: 108rpx;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #087a51;
  color: #ffffff;
  font-size: 58rpx;
  line-height: 1;
  box-shadow: 0 8rpx 24rpx rgba(8, 122, 81, 0.25);
}
