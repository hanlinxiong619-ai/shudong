<image class="page-bg" src="/assets/treehole-background.jpg" mode="aspectFill"/><view class="page"><view class="header"><text class="brand">花海鸽舍</text><image class="brand-logo" src="/assets/icons/brand.png" mode="aspectFill"/></view><view class="search"><input placeholder="搜索全部帖子" value="{{search}}" bindinput="inputSearch" bindconfirm="search" confirm-type="search"/><button bindtap="search">搜索</button></view><view class="hot-box" bindtap="showHot"><text>树洞热榜 · 查看最热的10条帖子</text><text>›</text></view><scroll-view class="categories" scroll-x><view class="category {{activeBoard===''?'active':''}}" data-code="" bindtap="chooseBoard"><image class="category-img" src="/assets/icons/treehole.png" mode="aspectFit"/><text>全部</text></view><view class="category {{activeBoard===item.code?'active':''}}" wx:for="{{boards}}" wx:key="code" data-code="{{item.code}}" bindtap="chooseBoard"><image class="category-img" src="/assets/icons/{{item.code}}.png" mode="aspectFit"/><text>{{item.name}}</text></view></scroll-view><view wx:if="{{!posts.length}}" class="empty">还没有帖子，来发布第一条吧</view><view class="post-card" wx:for="{{posts}}" wx:key="id" data-id="{{item.id}}" bindtap="openPost"><view class="post-head"><image class="avatar" src="{{item.avatarUrl||'/assets/icons/pigeon.png'}}" mode="aspectFill"/><text>{{item.nickname||'匿名用户'}}</text><text class="time">{{item.createdAt}}</text></view><view class="board">{{item.boardName}}</view><view wx:if="{{item.title}}" class="title">{{item.title}}</view><view class="content">{{item.content}}</view><scroll-view wx:if="{{item.images&&item.images.length}}" class="post-images" scroll-x enhanced show-scrollbar="{{false}}"><image wx:for="{{item.images}}" wx:key="*this" src="{{item}}" mode="aspectFill"/></scroll-view><view class="stats">◷ {{item.viewCount||0}}　♡ {{item.likeCount||0}}　□ {{item.commentCount||0}}</view></view><button wx:if="{{showTop}}" class="back-top" bindtap="backTop">↑</button><movable-area class="fab-area"><movable-view class="fab" direction="all" x="300" y="500" out-of-bounds bindtap="publish">＋</movable-view></movable-area></view>


