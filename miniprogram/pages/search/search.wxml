<view class="page"><view class="search"><input focus value="{{q}}" bindinput="input" bindconfirm="submit" placeholder="搜索全部帖子" confirm-type="search"/><button bindtap="submit">搜索</button></view><view wx:if="{{loading}}" class="empty">正在搜索...</view><view wx:if="{{!loading&&!posts.length}}" class="empty">没有找到相关帖子</view><view wx:for="{{posts}}" wx:key="id" class="post-card" data-id="{{item.id}}" bindtap="open"><view class="post-head"><image class="avatar" src="{{item.avatarUrl||'/assets/icons/pigeon.png'}}" mode="aspectFill"/><text class="nickname">{{item.nickname||'匿名用户'}}</text><view class="result-meta"><text class="board">{{item.boardName||item.boardCode}}</text><text class="result-time">{{item.createdAt}}</text></view></view><view class="title">{{item.title||'无标题'}}</view><view class="content">{{item.content}}</view><view class="stats"><text>♡ {{item.likeCount||0}}</text><text>回复 {{item.commentCount||0}}</text><text>围观 {{item.viewCount||0}}</text></view></view><button wx:if="{{showTop}}" class="back-top" bindtap="backTop">↑</button></view>
