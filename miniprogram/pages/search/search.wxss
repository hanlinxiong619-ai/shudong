.page{min-height:100vh;padding:30rpx;background:linear-gradient(145deg,#a8dfc0,#dff6e7,#fbfbe8);box-sizing:border-box}.search{height:82rpx;background:#fff;border:2rpx solid #49a681;border-radius:46rpx;padding-left:25rpx;display:flex;align-items:center;overflow:hidden;position:sticky;top:0;z-index:20}.search input{flex:1;min-width:0}.search button{width:128rpx;height:82rpx;line-height:82rpx;padding:0;border-radius:0;background:#20a878;color:#fff;font-size:27rpx}.search button::after{border:0}.post-card{background:#fff;border-radius:18rpx;padding:24rpx;margin-top:20rpx}.post-head{display:flex;align-items:center}.avatar{width:52rpx;height:52rpx;border-radius:50%;margin-right:14rpx}.nickname{font-size:26rpx;color:#31594a}.board{margin-left:auto;color:#087a51;font-size:23rpx}.title{font-size:30rpx;font-weight:600;margin-top:14rpx}.content{color:#415c52;margin-top:8rpx;line-height:1.6}.stats{display:flex;gap:28rpx;margin-top:18rpx;color:#84988f;font-size:23rpx}.empty{text-align:center;color:#899;padding:100rpx 0}.result-meta{margin-left:auto;display:flex;flex-direction:column;align-items:flex-end}.result-time{margin-top:4rpx;color:#99a69f;font-size:20rpx}.back-top{position:fixed;right:28rpx;bottom:150rpx;z-index:40;width:82rpx;height:82rpx;line-height:78rpx;padding:0;border-radius:50%;background:#159b70;color:#fff;font-size:38rpx;box-shadow:0 8rpx 24rpx rgba(0,0,0,.18)}
